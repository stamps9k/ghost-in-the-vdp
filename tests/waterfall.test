# Waterfall: enter from the colour cycle with Left (it wraps to the last
# scene). Init keeps the display off for about 58 frames while it
# generates the tiles and runs the spray up to speed. Then watch the
# flow, and exercise speed, reverse and pause.
run 20
press left
run 80
shot falls-start           fe8ee225 # moon, cliffs, falls, pool, spray in full flow
run 60
shot falls-flow            57d77b50 # palette has stepped; spray and ripples moved
press c
run 60
shot falls-fast            0f9d3f87 # C: 3/4 of a step per frame
press b
run 60
shot falls-reverse         77f9b458 # B: water climbs, spray falls back
press start
run 30
shot paused-a              77f9b458 # Start: paused...
run 60
shot paused-b              77f9b458 # ...so this frame must match paused-a
press start
run 30
shot resumed               9fb82661 # still reversed, from where it stopped
